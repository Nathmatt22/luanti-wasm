# The build uses shared memory, so the page has to be cross-origin isolated:
# without these two headers the browser refuses to start it. This file is what
# Cloudflare Pages and Netlify read; for nginx or Caddy see .github/README.md.

/*
	Cross-Origin-Opener-Policy: same-origin
	Cross-Origin-Embedder-Policy: credentialless
	Cross-Origin-Resource-Policy: same-origin

# The manifest names the zips by the hash of their contents, so it is the one
# file that has to be asked about again on every visit.
/packs.json
	Cache-Control: no-cache

# Everything else is named after its contents, or is small.
/luanti.js
	Cache-Control: no-cache

# The page itself is not named after anything: a launcher that keeps working
# from the cache is a launcher that cannot be fixed by uploading a new one.
/
	Cache-Control: no-cache
/index.html
	Cache-Control: no-cache
/launcher.js
	Cache-Control: no-cache
/menu.js
	Cache-Control: no-cache
/mod-handoff.js
	Cache-Control: no-cache
